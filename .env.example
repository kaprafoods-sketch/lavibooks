# ── Supabase ────────────────────────────────────────────────────────────────
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER expose to the browser. Used by seed script + Edge crons.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Market data (Finnhub free tier) ──────────────────────────────────────────
# https://finnhub.io/  — free tier: 60 req/min, delayed quotes, daily bars.
FINNHUB_API_KEY=your-finnhub-key

# ── Simulation defaults (overridable per-portfolio in sim_config) ─────────────
SIM_SLIPPAGE_BPS=5
SIM_COMMISSION_CENTS=0
# Quote cache TTL in seconds — never call the vendor per render.
PRICE_CACHE_TTL_SECONDS=60
